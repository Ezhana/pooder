{
  "name": "pooder",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "pnpm exec prettier . --write",
    "format:check": "pnpm exec prettier . --check",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "test:import-safety": "node tests/import-no-window.mjs && node tests/import-dom-without-canvas-context.mjs",
    "test:integration": "pnpm build && pnpm --filter @pooder/integration-tests test",
    "test:package-boundaries": "node tests/tool-package-boundaries.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "prettier": "^3.7.4",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
