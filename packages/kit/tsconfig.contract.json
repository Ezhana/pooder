{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@pooder/core": ["../core/src/index.ts"],
      "@pooder/core/internal/legacy-extension": ["../core/src/internal/legacy-extension.ts"],
      "@pooder/document": ["../document/src/index.ts"],
      "@pooder/document-core": ["../document-core/src/index.ts"]
    }
  },
  "include": ["tests/image-slot-v7.contract.ts", "src/**/*.ts"]
}
