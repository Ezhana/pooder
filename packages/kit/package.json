{
  "name": "@pooder/kit",
  "version": "8.0.1",
  "description": "Standard plugins for Pooder editor",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "tsc -p tsconfig.test.json && node -r ./.test-dist/kit/tests/setup-paper.js .test-dist/kit/tests/run.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/paper": "^0.12.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@pooder/core": "workspace:*",
    "@pooder/document": "workspace:*",
    "paper": "^0.12.18"
  }
}
