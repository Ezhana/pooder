{
  "name": "@pooder/kit",
  "version": "10.0.0",
  "description": "Optional aggregate install entry for official Pooder tools",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.mjs",
      "require": "./dist/document.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/document.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/document.ts --format cjs,esm --dts --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pooder/tools": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
