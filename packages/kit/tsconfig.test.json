{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "baseUrl": ".",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".test-dist",
    "rootDir": "..",
    "paths": {
      "@pooder/core": ["../core/src/index.ts"],
      "@pooder/document": ["../document/src/index.ts"],
      "@pooder/document-core": ["../document-core/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"]
}
