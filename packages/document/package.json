{
  "name": "@pooder/document",
  "version": "1.0.0",
  "description": "Versioned editor document contracts for Pooder",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.mjs",
      "require": "./dist/kit.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/kit.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/kit.ts --format cjs,esm --dts --watch",
    "test": "tsc -p tsconfig.test.json && node .test-dist/tests/run.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
